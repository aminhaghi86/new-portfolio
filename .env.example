# Public Turnstile site key (never the secret key)
VITE_TURNSTILE_SITE_KEY=
# Production n8n webhook (the workflow must be active)
VITE_N8N_WEBHOOK_URL=https://n8n.haghiweb.cloud/webhook/hire-me

# Optional: only for an additional URL-prefix HTML-tag verification method.
# Domain properties use existing DNS verification; no token is needed here.
GOOGLE_SITE_VERIFICATION=
