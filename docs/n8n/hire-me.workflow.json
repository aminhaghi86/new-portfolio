{
  "name": "Portfolio contact form → Telegram (hire-me)",
  "nodes": [
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "4f6c2d0e-8a8b-4b1e-9c3a-7d1e2f3a4b5c",
      "parameters": {
        "httpMethod": "POST",
        "path": "hire-me",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://www.haghiweb.ir,https://haghiweb.ir,http://localhost:5173"
        }
      }
    },
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000002",
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\nconst headers = $json.headers ?? {};\nconst clean = (value, max) => (typeof value === 'string' ? value.trim().slice(0, max) : '');\n\nconst data = {\n  name: clean(body.name, 100),\n  email: clean(body.email, 254),\n  phone: clean(body.phone, 50),\n  company: clean(body.company, 150),\n  message: clean(body.message, 2100),\n  captcha: clean(body.captcha, 2048),\n  submittedAt: clean(body.submittedAt, 40),\n  ip: clean(headers['cf-connecting-ip'], 64),\n};\n\ndata.valid = Boolean(\n  data.name && data.message && data.captcha &&\n  /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.email)\n);\n\nreturn { json: data };"
      }
    },
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000003",
      "name": "Input valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000004",
      "name": "Verify Turnstile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200],
      "parameters": {
        "method": "POST",
        "url": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "secret", "value": "PASTE_TURNSTILE_SECRET_KEY_HERE" },
            { "name": "response", "value": "={{ $json.captcha }}" },
            { "name": "remoteip", "value": "={{ $json.ip }}" }
          ]
        },
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000005",
      "name": "Captcha OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.success === true }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            },
            {
              "id": "c3",
              "leftValue": "={{ ['www.haghiweb.ir', 'haghiweb.ir', 'localhost'].includes($json.hostname) }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000006",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1100, 100],
      "parameters": {
        "chatId": "PASTE_YOUR_CHAT_ID_HERE",
        "text": "=📩 درخواست جدید از سایت\n\n👤 نام: {{ $('Validate input').item.json.name }}\n📧 ایمیل: {{ $('Validate input').item.json.email }}\n📞 تلفن: {{ $('Validate input').item.json.phone || '—' }}\n🏢 شرکت: {{ $('Validate input').item.json.company || '—' }}\n🕒 زمان: {{ $('Validate input').item.json.submittedAt || $now.toISO() }}\n\n📝 پیام:\n{{ $('Validate input').item.json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000007",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 100],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": true\n}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "1b0f7e64-0c1a-4b51-9a01-000000000008",
      "name": "Respond rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 420],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": false\n}",
        "options": { "responseCode": 400 }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Validate input", "type": "main", "index": 0 }]]
    },
